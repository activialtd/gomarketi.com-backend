ENV=development
PORT=8086
DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000

# Local dev: reuse the same RS256 keypair the Go auth service uses
# (generated once via `make gen-keys` at the repo root).
JWT_PRIVATE_KEY_PATH=../../keys/private.pem
JWT_PUBLIC_KEY_PATH=../../keys/public.pem
JWT_ACCESS_TTL_SECONDS=3600

# Staging/production instead set JWT_PRIVATE_KEY_B64 / JWT_PUBLIC_KEY_B64
# from SSM (same base64 values as /gomarketi/{env}/auth/JWT_*_KEY_B64).
