# api.gomarketi.com stays alongside api.wojalo.com during the rebrand: the
# installed mobile app and any cached web build still call it. Drop it once
# the app update has rolled out and the old domain's traffic has gone quiet.
api.wojalo.com, api.gomarketi.com {
	encode zstd gzip

	# SSE needs streaming, not buffering
	reverse_proxy gateway:8080 {
		flush_interval -1
	}
}
